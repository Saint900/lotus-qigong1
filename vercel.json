{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install --ignore-scripts",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets/|favicon|api/).*)",
      "destination": "/index.html"
    }
  ]
}
